      "content": {
        "factory": "team",
        "digest": "sha256:826afa8715611b60f14f8133bef68523cfbb16106d402a613047be92b4a26798",
        "definition": {
          "schemaVersion": 3,
          "description": "A general software change, from plan to release: plan, review the plan,\nimplement, verify, review the change, release.\n\nFor: changes to any codebase. A person approves the plan and the release,\nand confirms abandoning the work. A review with a blocking finding, or a\nfailed verify, sends the work back. Every check and the release are bound\nto the commit named in change-summary. Stages name tracker status keys, so\na work item can drive a ticket; drop the stages' tracker blocks if it will\nnot. For a swamp extension, build-swamp-extension.yaml adds a quality score\nand a manifest version check.\n\nChange first: verify's command (your project's checks), the skills the\nplan-review and code-review stages load, and release's description (how\nyour project ships).",
          "stages": [
            {
              "id": "plan",
              "description": "Plan the change.",
              "initial": true,
              "work": {
                "mode": "interactive",
                "skills": [],
                "systemPrompt": "First, check the work is not a duplicate of another ticket. If it\nis, find out whether that ticket, the primary, already has a work\nitem: run the tracker's claim on it with dryRun=true, which writes\nnothing. Record duplicate-of with the primary's stable id, its\ndisplay id and why, and wait for a person to approve\nduplicate-confirmation; do not plan. Once it is approved, move the\nwork to the primary. When the primary has no work item, retarget\nthis work item onto the primary's externalRefs and publish at once,\nso the ticket index follows before anyone claims the primary, then\nplan the primary's work here. When it has one, take the duplicate\nexit.\n\nPlan the change with the person. Read the code it touches first.\nRecord plan with a summary, the steps in order (each naming the files\nit touches) and the testing strategy.\n\nOn a later plan, read the injected plan (the last one), plan-review\n(its review) and plan-feedback (the person's latest feedback); the\nfirst plan has none of them. After a review sends the plan back,\naddress its findings. After revise, address the feedback. Record\nfeedbackIncorporated as the last plan's list, adding the feedback word\nfor word unless it is already the list's last entry: after rework,\nplan-feedback is the feedback the last plan already answered.\n",
                "context": {
                  "inject": [
                    "plan",
                    "plan-review",
                    "plan-feedback"
                  ]
                }
              },
              "artifacts": [
                {
                  "name": "plan",
                  "schema": {
                    "type": "object",
                    "required": [
                      "summary",
                      "steps",
                      "testingStrategy"
                    ],
                    "properties": {
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "steps": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": [
                            "description",
                            "files"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "description": {
                              "type": "string",
                              "minLength": 1
                            },
                            "files": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      },
                      "testingStrategy": {
                        "type": "string",
                        "minLength": 1
                      },
                      "feedbackIncorporated": {
                        "description": "Every round of a person's plan feedback this plan answers, oldest first.",
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                {
                  "name": "duplicate-of",
                  "schema": {
                    "type": "object",
                    "required": [
                      "primary",
                      "display",
                      "reason"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "primary": {
                        "description": "The primary ticket's stable id.",
                        "type": "string",
                        "minLength": 1
                      },
                      "display": {
                        "description": "The primary ticket's display id.",
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ],
              "transitions": [
                {
                  "name": "submit",
                  "to": "plan-review",
                  "gates": [
                    {
                      "type": "artifact-exists",
                      "config": {
                        "artifact": "plan"
                      }
                    }
                  ]
                },
                {
                  "name": "duplicate",
                  "to": "duplicate",
                  "description": "The work duplicates a primary ticket that already has a work item; a person confirms it. When the primary has none, the work item is retargeted onto it instead, and the cel gate closes this exit to it. \"builtin\" there is the built-in tracker's externalRefs key; a definition for Linear names \"linear\".",
                  "gates": [
                    {
                      "type": "human-approval",
                      "config": {
                        "id": "duplicate-confirmation"
                      }
                    },
                    {
                      "type": "cel",
                      "config": {
                        "expr": "\"duplicate-of\" in artifacts && (!(\"builtin\" in item.externalRefs) || item.externalRefs[\"builtin\"] != artifacts[\"duplicate-of\"].payload.primary)",
                        "message": "this work item is on the primary ticket now; plan it here"
                      }
                    }
                  ]
                }
              ],
              "tracker": {
                "status": "open",
                "duplicate": {
                  "on": {
                    "approve": "duplicate-confirmation"
                  },
                  "record": "duplicate-of",
                  "field": "primary"
                }
              }
            },
            {
              "id": "plan-review",
              "description": "Adversarial review of the current plan. Open blocking findings send it back; none lets it through. With nothing blocking, approving carries the open medium and low findings into implement, which receives plan-review; revise is for when the person wants the plan itself changed and reviewed again.",
              "work": {
                "mode": "dispatch",
                "skills": [
                  "adversarial-review"
                ],
                "systemPrompt": "You are an adversarial reviewer. Try to refute this plan:\n{{planSummary}}\nCheck its steps against the code and its testing strategy against the\nrisks.\nRate a finding critical or high only if the plan would ship a\ndefect, lose data, break a stated rule, or make the declared checks\nmeaningless. Gaps in process, logistics or manual verification that\nthe automated checks already cover are medium at most. Judge the\nplan against the size of the change: do not ask for verification\nmachinery bigger than the change, and give the smallest adequate fix\nfor each finding. Report findings with severities, and do not soften\nthe severity of a real defect.\n",
                "context": {
                  "inject": [
                    "plan"
                  ]
                },
                "let": {
                  "planSummary": "artifacts[\"plan\"].payload.summary"
                }
              },
              "artifacts": [
                {
                  "name": "plan-review",
                  "kind": "findings",
                  "reviews": "plan"
                }
              ],
              "evidence": [
                {
                  "name": "plan-feedback",
                  "description": "A person's feedback on the plan, in their words; revise needs it. The round is the cycle it was recorded in.",
                  "schema": {
                    "type": "object",
                    "required": [
                      "feedback"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "feedback": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "recordedBy": "person"
                }
              ],
              "transitions": [
                {
                  "name": "approve",
                  "to": "implement",
                  "gates": [
                    {
                      "type": "artifact-fresh",
                      "config": {
                        "artifact": "plan-review",
                        "recordedThisCycle": true
                      }
                    },
                    {
                      "type": "findings-clear",
                      "config": {
                        "artifact": "plan-review",
                        "blocking": [
                          "critical",
                          "high"
                        ]
                      }
                    },
                    {
                      "type": "human-approval",
                      "config": {
                        "id": "plan-approval"
                      }
                    }
                  ]
                },
                {
                  "name": "rework",
                  "to": "plan",
                  "description": "The fresh plan review has an open critical or high finding, so the plan goes back to be fixed.",
                  "gates": [
                    {
                      "type": "artifact-fresh",
                      "config": {
                        "artifact": "plan-review",
                        "recordedThisCycle": true
                      }
                    },
                    {
                      "type": "findings-open",
                      "config": {
                        "artifact": "plan-review",
                        "blocking": [
                          "critical",
                          "high"
                        ]
                      }
                    }
                  ]
                },
                {
                  "name": "revise",
                  "to": "plan",
                  "description": "A person sent the plan back without a blocking finding, to change the plan itself and have it reviewed again. To act on non-blocking findings during implement, approve instead. Manual, so it never fires on its own, and the person's feedback is recorded first, so every revision carries its reason to the next plan.",
                  "manual": true,
                  "gates": [
                    {
                      "type": "evidence-recorded",
                      "description": "The person's feedback on this plan is recorded.",
                      "config": {
                        "name": "plan-feedback"
                      }
                    }
                  ]
                }
              ],
              "tracker": {
                "status": "open"
              }
            },
            {
              "id": "implement",
              "description": "Implement the plan and commit it.",
              "work": {
                "mode": "interactive",
                "skills": [],
                "systemPrompt": "Implement the plan. Commit the work, then record change-summary with\nthe full 40-character SHA of the commit to check and review. Do not\nopen a pull request. After a check or review sends the work back, fix\nit, commit, and record change-summary again for the new commit.\n",
                "context": {
                  "inject": [
                    "plan",
                    "plan-review"
                  ]
                }
              },
              "artifacts": [
                {
                  "name": "change-summary",
                  "schema": {
                    "type": "object",
                    "required": [
                      "summary",
                      "commit",
                      "files"
                    ],
                    "properties": {
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "commit": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}$"
                      },
                      "files": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              ],
              "transitions": [
                {
                  "name": "submit",
                  "to": "verify",
                  "gates": [
                    {
                      "type": "artifact-exists",
                      "config": {
                        "artifact": "change-summary"
                      }
                    }
                  ]
                }
              ],
              "tracker": {
                "status": "in_progress"
              }
            },
            {
              "id": "verify",
              "description": "Run the checks on the change-summary commit and record checks, with one result per check.",
              "work": {
                "mode": "interactive",
                "systemPrompt": "Check out commit {{commit}} and run the stage's command. Record checks\nwith that commit, the overall status, and one result per check (its\nname, status and, when it failed, the output that shows why). Record\nonly what you ran and saw.\n",
                "command": "the project's format, lint, type and test checks (replace this with the real commands)",
                "let": {
                  "commit": "artifacts[\"change-summary\"].payload.commit"
                }
              },
              "evidence": [
                {
                  "name": "checks",
                  "schema": {
