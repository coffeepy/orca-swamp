{
  "manifestVersion": 2,
  "id": "swampling",
  "name": "Swampling",
  "version": "0.5.1",
  "description": "Shows the swamp workflows of the focused workspace's repo with each run's steps, logs, outputs and data; approves or rejects waiting gates; and hands a failed run to an agent terminal.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "swampling",
        "title": "Swampling",
        "icon": "layers",
        "entry": "src/app.ts",
        "ui": "html"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "terminal:send"
    }
  ]
}
